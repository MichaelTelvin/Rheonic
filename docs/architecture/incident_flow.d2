direction: down

vars: {
  d2-config: {
    pad: 22
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

ingest: "Ingest\nPOST /api/v1/events\nscope: project+provider" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

counters: "Rolling Counters + Baseline Sample\nrequests_60s / tokens_60s\nbaseline snapshots (project+provider)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

gate: "BaselineGate\nwarm-up vs ready\nallows early absolute spike checks in warm-up" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

detectors: "Detector(s)\nreq_spike + tok_spike\nemit Signal objects\nfuture: retry_storm / loop_suspect / token_explosion" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

incident_manager: "IncidentManager\nopen / update / escalate\n(project+provider scope)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

webhooks: "Webhook hooks\nincident.high (open high)\nincident.high (escalation -> high)\nincident.resolved (manual/auto)" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

autoclose: "Auto-close\nresolve stale open incidents\ninactivity cooldown" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

resolved: "Resolved incidents\n(manual or auto)" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

dashboard: "Dashboard metrics\nproject totals aggregate across providers\noptional provider filter" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

ingest -> counters
counters -> gate
gate -> detectors
detectors -> incident_manager
incident_manager -> webhooks
incident_manager -> autoclose
autoclose -> resolved
resolved -> dashboard
