direction: down

vars: {
  d2-config: {
    pad: 10
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

event: "Runtime event\nsent to Rheonic" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 14
  }
}

signals: "Usage signals update\nRecent requests and token activity" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 14
  }
}

risk_check: "Risk is evaluated\nNear-cap pressure or unusual patterns" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 14
  }
}

incident: "Incident opens or updates\nRepeated activity is grouped together" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 14
  }
}

alerts: "Alerts are queued\nWebhook or email can be sent" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 14
  }
}

delivery: "Alert delivery runs\nRetries happen automatically" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 14
  }
}

resolve: "Incident resolves\nManually or after activity settles" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 14
  }
}

history: "Incident history\nOpen and resolved states are kept" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 14
  }
}

dashboard: "Dashboard view\nLive incidents, history,\nand delivery results" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 14
  }
}

event -> signals
signals -> risk_check
risk_check -> incident
incident -> alerts
alerts -> delivery
delivery -> dashboard
incident -> resolve
resolve -> history
history -> alerts: "Resolved update"
history -> dashboard
