direction: down

vars: {
  d2-config: {
    pad: 10
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

event: "Runtime event\nsent to Rheonic" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 12
  }
}

signals: "Usage signals update\nRecent request and token activity" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 12
  }
}

risk_check: "Risk is evaluated\nNear-cap pressure or unusual patterns" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 12
  }
}

incident: "Incident opens or updates\nRepeated activity is grouped together" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 12
  }
}

alerts: "Alerts can be sent\nWebhook or email" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 12
  }
}

resolve: "Incident resolves\nManually or after activity settles" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 12
  }
}

dashboard: "Dashboard view\nLive incidents, history,\nand alert results" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 12
  }
}

event -> signals
signals -> risk_check
risk_check -> incident
incident -> alerts
incident -> resolve
alerts -> dashboard
resolve -> dashboard
