direction: down

vars: {
  d2-config: {
    pad: 10
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

event: "Runtime event\nsent to Rheonic" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 10
    font-size: 10
  }
}

signals: "Usage signals update\nRequests and tokens" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 10
    font-size: 10
  }
}

risk_check: "Risk is evaluated\nNear-cap or unusual patterns" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 10
    font-size: 10
  }
}

incident: "Incident opens or updates\nRelated activity is grouped" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 10
    font-size: 10
  }
}

alerts: "Alerts can be sent\nWebhook or email" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 10
    font-size: 10
  }
}

resolve: "Incident resolves\nManually or after traffic settles" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 10
    font-size: 10
  }
}

dashboard: "Dashboard view\nOpen incidents and history" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 10
    font-size: 10
  }
}

event -> signals
signals -> risk_check
risk_check -> incident
incident -> alerts
incident -> resolve
alerts -> dashboard
resolve -> dashboard
