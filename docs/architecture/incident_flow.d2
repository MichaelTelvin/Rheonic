direction: down

vars: {
  d2-config: {
    pad: 22
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

ingest: "Ingest\nPOST /api/v1/events\nscope: project+provider" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

counters: "Rolling Counters\nrequests_60s / tokens_60s\nscope: project+provider" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

detectors: "Detector(s)\nnear_cap\nretry_storm\nloop_suspect\ntoken_explosion\n+ cap_breach logging from counters" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

incident_manager: "IncidentManager\nopen / update\n(project+provider+incident_type)\ndedup window + count increment" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

webhooks: "Webhook hooks\nprotect mode only:\ndecision.warn / incident.warn / incident.block\nincident.resolved / policy_gap.detected\n(webhook.test is mode-independent)" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

autoclose: "Auto-close\nresolve stale open incidents\ninactivity cooldown" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

resolved: "Resolved incidents\n(manual or auto)" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

dashboard: "Dashboard metrics\nproject totals aggregate across providers\noptional provider filter" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

ingest -> counters
counters -> detectors
detectors -> incident_manager
incident_manager -> webhooks
incident_manager -> autoclose
autoclose -> resolved
resolved -> dashboard
