direction: down

vars: {
  d2-config: {
    pad: 20
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

sdk_call: "SDK wrapper call\nalways runs preflight decision" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

mode_gate: "Backend project mode\nObserve or Protect" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

preflight: "Protect preflight\nPOST /api/v1/protect/decision\nscope: project+provider" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

inputs: "Decision inputs\nrolling counters (project+provider)\ncaps\nestimated_next_tokens (protect preflight only)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

caps: "Caps check (block)\ncooldown_active -> block\ntokens_60s >= tok_cap -> tok_cap_breach\nrequests_60s >= req_cap -> req_cap_breach" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

warn_signals: "Warn signals (protect mode only)\nnear_cap (predictive: req|tok|both)\nretry_storm\nloop_suspect\ntoken_explosion" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

ingest_note: "Ingest dominance (incident emission)\nL3 cap_breach > L2 near_cap > L1 behavioral\n(does not change decision order)" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

allow_warn: "allow / warn\nprovider call proceeds" {
  style: {
    fill: "#f6efd8"
    stroke: "#c6ac63"
    font-color: "#5e4a1f"
    border-radius: 14
    font-size: 13
  }
}

block: "block\nRHEONICBlockedError\nprovider call prevented" {
  style: {
    fill: "#f7e4ea"
    stroke: "#bf8095"
    font-color: "#61283d"
    border-radius: 14
    font-size: 13
  }
}

transport_outbox: "Transport outbox\nappend delivery row\nkind=webhook|email\ndedupe key enforced" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

transport_worker: "RQ transport worker\nclaim pending row\ndeliver webhook/email\nretry/backoff\nupdate outbox status" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

provider: "Provider call" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

ingest: "POST /api/v1/events\ntelemetry ingest\n(project+provider counters/incidents)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

incident_pipeline: "Incident pipeline source\nIngest counters -> Detector(s) -> IncidentManager\n+ preflight near_cap warn -> visible incident" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

metrics: "Protect metrics\nproject totals aggregate across providers\noptional provider filter\n+ delivery failures from outbox" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

finalizer: "Canonical outcome finalizer\none request_id -> one outcome\nsource: live | timeout_fallback | unavailable_fallback" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

fallback_report: "Fallback report\nSDK timeout/unavailable report\nsame request_id finalized once" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

sdk_call -> preflight
preflight -> mode_gate
mode_gate -> observe: "Observe"
mode_gate -> inputs: "Protect"
observe -> provider
inputs -> caps
inputs -> ingest_note
caps -> block: "block"
caps -> warn_signals: "no block"
warn_signals -> allow_warn: "warn / allow"
warn_signals -> transport_outbox: "warn -> protection.warn\nclamp -> protection.clamp_started"
warn_signals -> incident_pipeline: "near_cap -> visible incident"
block -> transport_outbox: "block -> protection.block"
allow_warn -> provider
preflight -> finalizer: "live outcome"
sdk_call -> fallback_report: "on timeout/unavailable"
fallback_report -> finalizer
provider -> ingest
transport_outbox -> transport_worker
transport_worker -> metrics
ingest -> incident_pipeline
ingest -> metrics
finalizer -> metrics: "allow / warn / block counters\n+ last outcome"
observe: "Observe mode result\nallow only\nincident.warn / incident.resolved\npolicy_gap.detected" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}
