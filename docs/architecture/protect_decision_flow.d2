direction: down

vars: {
  d2-config: {
    pad: 20
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

sdk_mode: "SDK Mode Check\nObserve or Protect" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

observe: "Observe path\nno preflight decision call" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

preflight: "Protect preflight\nPOST /api/v1/protect/decision\nscope: project+provider" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

inputs: "Decision inputs\nrolling counters\nincident severity (open)\ncaps + predictive near-cap" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

priority: "Decision priority\ncooldown -> hard caps -> incident high\n-> incident medium -> predictive warn -> allow" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

allow_warn: "allow / warn\nprovider call proceeds" {
  style: {
    fill: "#f6efd8"
    stroke: "#c6ac63"
    font-color: "#5e4a1f"
    border-radius: 14
    font-size: 13
  }
}

block: "block\nLLMTBGBlockedError\nprovider call prevented" {
  style: {
    fill: "#f7e4ea"
    stroke: "#bf8095"
    font-color: "#61283d"
    border-radius: 14
    font-size: 13
  }
}

provider: "Provider call" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

ingest: "POST /api/v1/events\ntelemetry ingest\n(project+provider counters/incidents)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

incident_pipeline: "Incident pipeline source\nBaselineGate -> Detector(s) -> IncidentManager\nfeeds incident severity for decisions" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

metrics: "Protect metrics\nproject totals aggregate across providers\noptional provider filter" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

sdk_mode -> observe: "Observe"
sdk_mode -> preflight: "Protect"
observe -> provider
preflight -> inputs
inputs -> priority
priority -> allow_warn: "allow/warn"
priority -> block: "block"
allow_warn -> provider
provider -> ingest
block -> metrics
ingest -> incident_pipeline
incident_pipeline -> inputs
ingest -> metrics
