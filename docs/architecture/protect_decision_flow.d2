direction: down

vars: {
  d2-config: {
    pad: 10
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

app_call: "App request\nthrough Rheonic SDK" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 19
  }
}

mode_gate: "Mode?\nObserve or Protect" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 19
  }
}

observe: "Observe mode\nRequest continues\nActivity is recorded" {
  style: {
    fill: "#eef3fb"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 19
  }
}

preflight: "Protect check\nTraffic and limits\nare reviewed" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 19
  }
}

hard_limit: "Hard limit hit?\nCap exceeded or cooldown active" {
  style: {
    fill: "#eef3fb"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 19
  }
}

risk_check: "Warning needed?\nNear cap or unusual spike" {
  style: {
    fill: "#eef3fb"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 19
  }
}

allow: "Allow\nRequest goes through" {
  style: {
    fill: "#f6efd8"
    stroke: "#c6ac63"
    font-color: "#5e4a1f"
    border-radius: 16
    font-size: 19
  }
}

warn: "Warn\nRequest goes through\nAlert is recorded" {
  style: {
    fill: "#f6efd8"
    stroke: "#c6ac63"
    font-color: "#5e4a1f"
    border-radius: 16
    font-size: 19
  }
}

block: "Block\nRequest is stopped\nbefore the provider call" {
  style: {
    fill: "#f7e4ea"
    stroke: "#bf8095"
    font-color: "#61283d"
    border-radius: 16
    font-size: 19
  }
}

provider: "Provider call" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 19
  }
}

alerts: "Alerts\nWebhook or email\nfor warn and block events" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 19
  }
}

recording: "Recorded outcomes\nUsage, decisions,\nand incidents" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 19
  }
}

fallback: "Fallback path\nUsed if protect check\nis unavailable or times out" {
  style: {
    fill: "#eef3fb"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 17
  }
}

dashboard: "Dashboard view\nMetrics, incidents,\nand latest results" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 17
  }
}

app_call -> mode_gate
mode_gate -> observe: "Observe"
mode_gate -> preflight: "Protect"
observe -> provider
preflight -> hard_limit
hard_limit -> block: "Yes"
hard_limit -> risk_check: "No"
risk_check -> warn: "Yes"
risk_check -> allow: "No"
allow -> provider
warn -> provider
warn -> alerts
block -> alerts
provider -> recording
observe -> recording
block -> recording
app_call -> fallback: "If needed"
fallback -> recording
recording -> dashboard
alerts -> dashboard
