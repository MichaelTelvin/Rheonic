direction: down

vars: {
  d2-config: {
    pad: 28
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

app_call: "App request\nsent through Rheonic SDK" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 16
  }
}

mode_gate: "Project mode?\nObserve or Protect" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 16
  }
}

observe: "Observe mode\nRequest continues\nRheonic records what happened" {
  style: {
    fill: "#eef3fb"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 16
  }
}

preflight: "Protect preflight\nChecks recent traffic and configured limits" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 16
  }
}

hard_limit: "Hard limit hit?\nCap exceeded or cooldown active" {
  style: {
    fill: "#eef3fb"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 16
  }
}

risk_check: "Risk warning?\nNear cap or unusual traffic spike" {
  style: {
    fill: "#eef3fb"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 16
  }
}

allow: "Allow\nRequest goes to provider" {
  style: {
    fill: "#f6efd8"
    stroke: "#c6ac63"
    font-color: "#5e4a1f"
    border-radius: 16
    font-size: 16
  }
}

warn: "Warn\nRequest goes to provider\nRheonic records a visible warning" {
  style: {
    fill: "#f6efd8"
    stroke: "#c6ac63"
    font-color: "#5e4a1f"
    border-radius: 16
    font-size: 16
  }
}

block: "Block\nRequest is stopped before the provider call" {
  style: {
    fill: "#f7e4ea"
    stroke: "#bf8095"
    font-color: "#61283d"
    border-radius: 16
    font-size: 16
  }
}

provider: "Provider call" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 16
  }
}

alerts: "Alerts\nWebhook or email for warn/block events" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 16
  }
}

recording: "Recorded outcomes\nUsage, protect decisions, and incidents" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 16
  }
}

fallback: "If the protect check is unavailable\nSDK records a fallback outcome" {
  style: {
    fill: "#eef3fb"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 16
  }
}

dashboard: "Dashboard view\nMetrics, incidents, and latest protect results" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 16
    font-size: 16
  }
}

app_call -> mode_gate
mode_gate -> observe: "Observe"
mode_gate -> preflight: "Protect"
observe -> provider
preflight -> hard_limit
hard_limit -> block: "Yes"
hard_limit -> risk_check: "No"
risk_check -> warn: "Yes"
risk_check -> allow: "No"
allow -> provider
warn -> provider
warn -> alerts
block -> alerts
provider -> recording
observe -> recording
block -> recording
app_call -> fallback: "If the check times out"
fallback -> recording
recording -> dashboard
alerts -> dashboard
