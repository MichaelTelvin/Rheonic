direction: down

vars: {
  d2-config: {
    pad: 20
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

preflight: "SDK preflight (protect mode)\nPOST /api/v1/protect/decision" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

sdk_gate: "SDK preflight enabled?\nprotectEnabled/protect_enabled" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

cooldown: "cooldown active?\nprotect_block_cooldown_seconds=60" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

mode: "protect_enabled?" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

req_cap: "requests_60s >= protect_max_req_per_min?\n(null = unlimited)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

tok_cap: "tokens_60s >= protect_max_tok_per_min?\n(null = unlimited)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

sev_high: "incident severity = high?\n(ratio >=10.0 or escalation)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

sev_medium: "incident severity = medium?\n(ratio >=5.0 or escalation)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

predictive: "predictive near-cap\nprecomputed before priority pick\nrequires protect_max_tok_per_min\n+ input_tokens_estimate\n(+ max_output_tokens if present)\nprotect_near_cap_factor=0.8" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

predictive_pick: "predictive_near_cap?\n(precomputed)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

warn: "warn\nreason=incident_medium\nor predictive_near_cap" {
  style: {
    fill: "#f6efd8"
    stroke: "#c6ac63"
    font-color: "#5e4a1f"
    border-radius: 14
    font-size: 17
  }
}

block: "block\nreason=cooldown_active\nor req_limit/tok_limit/incident_high\n(set cooldown key)" {
  style: {
    fill: "#f7e4ea"
    stroke: "#bf8095"
    font-color: "#61283d"
    border-radius: 14
    font-size: 17
  }
}

response: "decision response" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

enforce: "SDK enforcement\nallow/warn -> provider\nblock -> LLMTBGBlockedError\ntimeout_ms=100, fail_mode=open (default)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

provider: "Provider call\n(observe path or allow/warn)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

fallback: "SDK fallback on decision error/timeout\nfail-open -> allow (decision_unavailable)\nfail-closed -> block (decision_unavailable)" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 17
  }
}

sdk_gate -> preflight: "yes / protect"
sdk_gate -> provider: "no / observe"
preflight -> mode
mode -> response: "no / reason=ok"
mode -> cooldown: "yes"
cooldown -> block: "yes / reason=cooldown_active"
cooldown -> req_cap: "no"

req_cap -> block: "yes / reason=req_limit"
req_cap -> tok_cap: "no"

tok_cap -> block: "yes / reason=tok_limit"
tok_cap -> predictive: "no / compute predictive"

predictive -> sev_high: "continue priority"
sev_high -> block: "yes / reason=incident_high"
sev_high -> sev_medium: "no"

sev_medium -> warn: "yes / reason=incident_medium (higher priority)"
sev_medium -> predictive_pick: "no"

predictive_pick -> warn: "yes / reason=predictive_near_cap"
predictive_pick -> response: "no / reason=ok"

warn -> response
block -> response
response -> enforce
enforce -> provider: "allow/warn path"
fallback -> enforce
