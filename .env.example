########################################
# Runtime mode
########################################
APP_ENV=staging

########################################
# Core infra (required)
########################################
POSTGRES_DB=rheonic
POSTGRES_USER=rheonic
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://rheonic:change-me@postgres:5432/rheonic
REDIS_URL=redis://redis:6379/0

########################################
# Backend API (required)
########################################
BACKEND_PORT=8000
JWT_SECRET=replace-with-48-plus-char-random-secret
CORS_ORIGINS=https://your-frontend-domain.example
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-32-plus-char-random-secret
TRUST_PROXY_HEADERS=true
FORWARDED_ALLOW_IPS=*

########################################
# Frontend (required if frontend container is used)
########################################
FRONTEND_PORT=80
VITE_API_BASE_URL=https://api.your-domain.example
VITE_PUBLIC_CONTACT_EMAIL=support@your-domain.example
VITE_APP_VERSION=1.0.0

########################################
# Jobs/scheduler (optional overrides)
########################################
AUTO_CLOSE_RUN_INTERVAL_SECONDS=60
RQ_QUEUE_NAME=rheonic
RQ_SCHEDULER_INTERVAL_SECONDS=15
LOG_LEVEL=INFO

########################################
# Webhook/security optional hardening
########################################
WEBHOOK_ALLOW_PRIVATE_HOSTS=false

########################################
# Local test/e2e/demo variables (dev only; not required in prod)
########################################
# RHEONIC_INGEST_KEY=
# RHEONIC_BASE_URL=http://localhost:8000
# RHEONIC_BACKEND_URL=http://localhost:8000
# RHEONIC_PROVIDER_URL=http://localhost:8099
# RHEONIC_PROVIDER=openai
# RHEONIC_MODEL=gpt-4o-mini
# RHEONIC_ENVIRONMENT=dev
# RHEONIC_SCENARIO=allow
# RHEONIC_DEMO_CASE=steady
