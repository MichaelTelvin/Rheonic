########################################
# Runtime mode
########################################
APP_ENV=prod

########################################
# Core infra (required)
########################################
POSTGRES_DB=llmtbg
POSTGRES_USER=llmtbg
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://llmtbg:change-me@postgres:5432/llmtbg
REDIS_URL=redis://redis:6379/0

########################################
# Backend API (required)
########################################
BACKEND_PORT=8000
JWT_SECRET=replace-with-long-random-secret
CORS_ORIGINS=https://your-frontend-domain.example

########################################
# Frontend (required if frontend container is used)
########################################
FRONTEND_PORT=5173
VITE_API_BASE_URL=https://api.your-domain.example

########################################
# Jobs/scheduler (optional overrides)
########################################
AUTO_CLOSE_RUN_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

########################################
# Webhook/security optional hardening
########################################
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
WEBHOOK_SECRET_ENCRYPTION_KEY=

########################################
# Local test/e2e/demo variables (dev only; not required in prod)
########################################
# LLMTBG_INGEST_KEY=
# LLMTBG_BASE_URL=http://localhost:8000
# LLMTBG_BACKEND_URL=http://localhost:8000
# LLMTBG_PROVIDER_URL=http://localhost:8099
# LLMTBG_PROVIDER=openai
# LLMTBG_MODEL=gpt-4o-mini
# LLMTBG_ENVIRONMENT=dev
# LLMTBG_SCENARIO=allow
# LLMTBG_DEMO_CASE=steady
