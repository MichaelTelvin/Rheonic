direction: down

vars: {
  d2-config: {
    pad: 22
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

ingest: "Ingest\nPOST /api/v1/events\nscope: project+provider" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

counters: "Rolling Counters\nrequests_60s / tokens_60s\nscope: project+provider" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

detectors: "Detector(s)\nnear_cap (req|tok|both)\nretry_storm\nloop_suspect\ntoken_explosion\n+ cap_breach logging from counters\n\nDominance per event:\nL3 cap_breach > L2 near_cap > L1 behavioral" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

incident_manager: "IncidentManager\nopen / update\n(project+provider+incident_type)\ndedup window + count increment" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

transport_outbox: "Transport outbox\nappend delivery row\nkind=webhook|email\nstatus=pending/sending/delivered/failed/dead" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

transport_worker: "RQ transport worker\nclaim pending row\ndeliver webhook/email\nretry/backoff\nupdate terminal status" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

autoclose: "Auto-close\nresolve stale open incidents\ninactivity cooldown" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

resolved: "Resolved incidents\n(manual or auto)" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

dashboard: "Dashboard metrics\nproject totals aggregate across providers\noptional provider filter\n+ delivery failures from outbox" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 11
  }
}

ingest -> counters
counters -> detectors
detectors -> incident_manager
incident_manager -> transport_outbox
transport_outbox -> transport_worker
transport_worker -> dashboard
incident_manager -> autoclose
autoclose -> resolved
resolved -> transport_outbox: "incident.resolved"
resolved -> dashboard
