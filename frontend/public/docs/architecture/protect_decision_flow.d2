direction: down

vars: {
  d2-config: {
    pad: 20
    sketch: false
    layout-engine: elk
  }
}

style: {
  fill: "#f4f6fb"
}

sdk_mode: "SDK Mode Check\nObserve or Protect" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

observe: "Observe path\nno preflight decision call" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

preflight: "Protect preflight\nPOST /api/v1/protect/decision\nscope: project+provider" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

inputs: "Decision inputs\nrolling counters (project+provider)\ncaps\nestimated_next_tokens (protect preflight only)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

caps: "Caps check (block)\nrequests_60s >= req_cap -> req_cap_breach\ntokens_60s >= tok_cap -> tok_cap_breach\ncooldown_active -> block" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

warn_signals: "Warn signals (protect mode only)\nnear_cap (predictive: req|tok|both)\nretry_storm\nloop_suspect\ntoken_explosion" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

ingest_note: "Ingest dominance (incident emission)\nL3 cap_breach > L2 near_cap > L1 behavioral\n(does not change decision order)" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

allow_warn: "allow / warn\nprovider call proceeds" {
  style: {
    fill: "#f6efd8"
    stroke: "#c6ac63"
    font-color: "#5e4a1f"
    border-radius: 14
    font-size: 13
  }
}

block: "block\nLLMTBGBlockedError\nprovider call prevented" {
  style: {
    fill: "#f7e4ea"
    stroke: "#bf8095"
    font-color: "#61283d"
    border-radius: 14
    font-size: 13
  }
}

decision_webhooks: "Protect webhooks\nwarn -> decision.warn\nblock -> incident.block" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

provider: "Provider call" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

ingest: "POST /api/v1/events\ntelemetry ingest\n(project+provider counters/incidents)" {
  style: {
    fill: "#e8eef9"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

incident_pipeline: "Incident pipeline source\nCounters -> Detector(s) -> IncidentManager\n(no baseline / no severity)" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

metrics: "Protect metrics\nproject totals aggregate across providers\noptional provider filter" {
  style: {
    fill: "#e4edf8"
    stroke: "#7e95be"
    font-color: "#21324d"
    border-radius: 14
    font-size: 13
  }
}

sdk_mode -> observe: "Observe"
sdk_mode -> preflight: "Protect"
observe -> provider
preflight -> inputs
inputs -> caps
inputs -> ingest_note
caps -> block: "block"
caps -> warn_signals: "no block"
warn_signals -> allow_warn: "warn / allow"
warn_signals -> decision_webhooks: "warn"
block -> decision_webhooks: "block"
allow_warn -> provider
provider -> ingest
decision_webhooks -> metrics
ingest -> incident_pipeline
ingest -> metrics
