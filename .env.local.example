APP_ENV=dev

POSTGRES_DB=rheonic
POSTGRES_USER=rheonic
POSTGRES_PASSWORD=rheonic
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://rheonic:rheonic@postgres:5432/rheonic
REDIS_URL=redis://redis:6379/0

BACKEND_PORT=8000
FRONTEND_PORT=5173

JWT_SECRET=replace-with-local-dev-secret-min-32-chars
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

WEBHOOK_ALLOW_PRIVATE_HOSTS=false
WEBHOOK_SECRET_ENCRYPTION_KEY=replace-with-local-dev-encryption-key

AUTO_CLOSE_RUN_INTERVAL_SECONDS=60
RQ_QUEUE_NAME=rheonic
RQ_SCHEDULER_INTERVAL_SECONDS=15
LOG_LEVEL=INFO
